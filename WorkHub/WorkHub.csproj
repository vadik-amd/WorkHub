<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 TFM (not plain net10.0-windows): it turns on the WinRT projections, which
         is how Windows.Media.Ocr is reached for the screen-text feature. 17763 is the oldest
         SDK ref pack that still carries the OCR API, so nothing new is downloaded. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>WorkHub</AssemblyName>
    <RootNamespace>WorkHub</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Single self-contained exe: `dotnet publish -c Release` needs no extra flags. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- No debug symbols in output. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenVINO sidecar scripts: shipped inside the single-file exe, written out at run time. -->
    <None Remove="ov_whisper.py" />
    <EmbeddedResource Include="ov_whisper.py" LogicalName="WorkHub.ov_whisper.py" />
    <None Remove="ov_screen_vlm.py" />
    <EmbeddedResource Include="ov_screen_vlm.py" LogicalName="WorkHub.ov_screen_vlm.py" />
  </ItemGroup>

</Project>
